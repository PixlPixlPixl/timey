# ─────────────────────────────────────────────────────────────────────
# Timey — local environment / secrets file (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` for your own local overrides:
#
#     cp .env.example .env
#
# `.env` is listed in `.gitignore`, so anything you put in it stays on
# your machine and can NEVER be committed or pushed. Only ever put real
# secrets/tokens/keys into your local `.env`, never into `.env.example`
# or any file that is tracked by git.
#
# All keys in this file are optional.

# Initial color theme used on the very first launch, before you have
# saved a preference from the app's own toggle.
# Valid values: dark | light   (Timey defaults to dark)
TIMEY_THEME=dark

# Initial "keep running in the background" value on the very first
# launch. The launcher generated by install.sh sets this to 1, so an
# installed Timey keeps alarms/timers running (and ringing) after the
# window is closed. Development checkouts default to 0.
# Valid values: 0 | 1   (Timey defaults to 0)
# TIMEY_BACKGROUND_DEFAULT=0

# Future keys (API endpoints, tokens, telemetry, …) go here. Real values
# belong only in your local `.env` file.
# TIMEY_API_ENDPOINT=
# TIMEY_API_TOKEN=
